{
  "name": "multiplet-analysis",
  "version": "2.1.5",
  "license": "MIT",
  "description": "Extract coupling constants from a complex NMR multiplet",
  "keywords": [],
  "author": "Luc Patiny",
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "cheminfo-types": "^1.15.0",
    "fft.js": "^4.0.4",
    "ml-airpls": "^2.2.0",
    "ml-spectra-processing": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@zakodium/tsconfig": "^1.0.5",
    "eslint": "^9.39.4",
    "eslint-config-cheminfo-typescript": "^22.0.0",
    "jest-matcher-deep-close-to": "^3.0.2",
    "nmr-processing": "^22.10.0",
    "nmr-simulation": "^1.0.21",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/multiplet-analysis.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/multiplet-analysis/issues"
  },
  "homepage": "https://github.com/cheminfo/multiplet-analysis#readme"
}
